# /etc/walkie/walkie.env  (readable only by root and the walkie user)
WALKIE_ADDR=127.0.0.1:8080
WALKIE_DATA=/var/lib/walkie
WALKIE_PUBLIC_URL=https://YOURNAME.duckdns.org

# iPhone push (from developer.apple.com > Keys). Optional but needed for the
# lock-screen walkie-talkie and SOS alerts on iPhone.
#WALKIE_APNS_KEY_FILE=/etc/walkie/AuthKey_ABC123DEFG.p8
#WALKIE_APNS_KEY_ID=ABC123DEFG
#WALKIE_APNS_TEAM_ID=YOURTEAMID
#WALKIE_APNS_BUNDLE_ID=com.debayandatta.walkie
#WALKIE_APNS_CRITICAL=0

# Android push (Firebase > Project settings > Service accounts > Generate key).
#WALKIE_FCM_SERVICE_ACCOUNT=/etc/walkie/firebase-service-account.json
