[Unit]
Description=Walkie family walkie-talkie server
After=network-online.target
Wants=network-online.target

[Service]
User=walkie
Group=walkie
EnvironmentFile=/etc/walkie/walkie.env
WorkingDirectory=/var/lib/walkie
ExecStart=/usr/local/bin/walkie serve
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/walkie
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
